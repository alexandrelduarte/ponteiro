# ============================================================
# AGREGADOR PRESIDENCIAL 2026 — variáveis de ambiente
# Copie para .env.local (dev) e configure as mesmas na Vercel.
# Valores reais NUNCA entram no git (.env* está no .gitignore).
# ============================================================

# URL pública do site (usada em metadata, OG e sitemap)
NEXT_PUBLIC_SITE_URL=https://seu-dominio.com.br

# --- Supabase (opcionais em dev: sem elas o site cai para o seed local — R8) ---
# Painel do projeto → Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role: SERVER-ONLY. Jamais renomeie para NEXT_PUBLIC_*.
SUPABASE_SERVICE_ROLE_KEY=

# --- Anthropic (updater diário de pesquisas; server-only) ---
ANTHROPIC_API_KEY=
# Modelo do coletor (padrão do produto)
ANTHROPIC_MODEL=claude-sonnet-4-6

# --- Cron (Vercel Cron chama /api/cron/atualizar com Authorization: Bearer $CRON_SECRET) ---
# Gere um valor aleatório longo: `openssl rand -hex 32`
CRON_SECRET=

# --- Admin (e-mails autorizados no /admin, separados por vírgula; checados no servidor) ---
ADMIN_EMAILS=voce@exemplo.com

# --- Opcionais ---
SENTRY_DSN=
